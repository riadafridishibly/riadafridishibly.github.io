# layout: elk
# vertical: queue

**.style.bold: false
direction: down

asks: What asks for work {
  calls: "engine calls:\nopen body, flush outbox"
  hint: "hint:\nfolder in view"
  open: "open +\n5 min poll"
  wake: "wake:\nIDLE watch saw mail"
}

queue: Keyed queue {
  i: "Interactive\nalways first"
  b: "Background\n3 of every 4\nremaining picks"
  f: "Backfill\n1 of every 4"
}

slots: "3 task slots\none bounded step each"
pool: "connection pool\nbackoff, breaker"
server: "IMAP server" {shape: cloud}
watch: "IDLE watch\nown connection"

asks.calls -> queue.i
asks.hint -> queue.i
asks.open -> queue.b
asks.wake -> queue.b
queue.i -> slots
queue.b -> slots
queue.f -> slots
slots -> pool
pool -> server
watch -> server
